# Supabase (đọc read-only cho dashboard). Thiếu -> dashboard tự dùng mock data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Webhook Telegram 2 chiều -> GitHub repo_dispatch
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=        # đặt khi setWebhook (header X-Telegram-Bot-Api-Secret-Token)
GH_DISPATCH_PAT=               # PAT scope 'repo' để bấm repo_dispatch
GH_OWNER=
GH_REPO=
