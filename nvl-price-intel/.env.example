# ===== Danh mục & dữ liệu =====
TICKERS=NVL
HISTORY_DAYS=120
DATA_SOURCE=tcbs            # tcbs | mock

# ===== Claude API (Anthropic) =====
# Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4000
ENABLE_AI_ANALYSIS=true

# ===== Telegram =====
# Tạo bot qua @BotFather để lấy token; lấy chat_id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Lưu trữ =====
STORAGE_BACKEND=sqlite      # sqlite | supabase
SQLITE_PATH=data/price_intel.db
SUPABASE_URL=
SUPABASE_KEY=

# ===== Lịch tự động =====
SCHEDULE_ENABLED=true
# Cron 5 trường: phút giờ ngày tháng thứ. Mặc định 16:00 các ngày T2-T6.
SCHEDULE_CRON=0 16 * * 1-5
TIMEZONE=Asia/Ho_Chi_Minh

# ===== Web / API =====
WEB_HOST=0.0.0.0
WEB_PORT=8000
API_TOKEN=                  # đặt 1 chuỗi bí mật để bảo vệ POST /run
REPORTS_DIR=data/reports

LOG_LEVEL=INFO
