# ==== Firecrawl Cloud ====
# Lay tai https://www.firecrawl.dev (Dashboard -> API Keys)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==== Database (Postgres) ====
POSTGRES_USER=resin
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=resin

# ==== Ti gia USD -> VND ====
FX_USD_VND_FALLBACK=25400
# FX_API_URL=https://open.er-api.com/v6/latest/USD

# ==== Canh bao Telegram ====
# Tao bot voi @BotFather de lay token; lay chat_id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_THRESHOLD_PCT=2

# ==== Lich chay (mac dinh 07:00 thu Hai hang tuan, gio VN) ====
SCHEDULE_DAY_OF_WEEK=mon
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
SCHEDULE_TZ=Asia/Ho_Chi_Minh
# Dat true de chay ngay 1 lan khi khoi dong (huu ich khi test)
RUN_ON_START=false

# ==== API bao ve (khi mo ra internet) ====
# De trong = API mo. Dat chuoi bi mat de yeu cau header X-API-Token.
API_TOKEN=
CORS_ORIGINS=*

# ==== Cong dashboard ====
DASHBOARD_PORT=8080
